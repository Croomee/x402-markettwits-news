# Copy to .env for local runs (node --env-file=.env server.mjs). On Render set these in the dashboard.
PAY_TO_ADDRESS=0x2c257EE70952a16f00c99d40fDFF2d28f1A5b8A2
# Base mainnet (default). Use eip155:84532 for Base Sepolia testnet.
X402_NETWORK=eip155:8453
PRICE=$0.003
# Coinbase CDP facilitator (required for mainnet). From https://portal.cdp.coinbase.com -> API keys.
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=
# Used only when CDP keys are empty (x402.org is testnet-only).
FACILITATOR_URL=https://x402.org/facilitator
# Long random value; enables POST /ingest. Leave empty to disable ingest.
INGEST_TOKEN=
# Optional
# PORT=4021
# HOST=0.0.0.0
# NEWS_FILE=data/news.jsonl
# Optional proxy for /product/info marketplace fetches only (Wildberries/Ozon). PROXY_URL wins over PROXY_HOST/PORT/USER/PASS.
# Schemes: http, https, socks5. Never commit real credentials. See scripts/beget-proxy-setup.sh.
# PROXY_URL=http://user:pass@1.2.3.4:3128
# PROXY_HOST=
# PROXY_PORT=3128
# PROXY_USER=
# PROXY_PASS=
# PROXY_SCOPE=wb,ozon
# PROXY_FALLBACK_DIRECT=true
# Optional headless-browser parser (parser/ on a VPS). When both are set, /product/info asks it first (via:"browser")
# and falls back to the HTTP chain above on any parser failure.
# PARSER_URL=http://159.194.215.201:8090
# PARSER_TOKEN=
# PARSER_TIMEOUT_MS=30000
