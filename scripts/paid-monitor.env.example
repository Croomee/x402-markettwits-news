# Copy to /etc/x402-monitor.env (chmod 600, owned by the user running the timer). Never commit the real file.
# Dedicated hot wallet on Base with a few USDC; the key file holds only the 0x... key (chmod 600).
X402_PRIVATE_KEY_FILE=/home/USER/.x402-monitor/key
X402_BASE_URL=https://x402-markettwits-news.onrender.com
X402_MAX_PAYMENT_USD=0.01
# Optional Telegram alerts (bot from @BotFather; chat id of you or a group with the bot)
TG_BOT_TOKEN=
TG_CHAT_ID=
# Optional
MONITOR_LOG=/home/USER/.x402-monitor/paid-monitor.jsonl
MONITOR_LOW_BALANCE_USD=0.5
BASE_RPC_URL=https://mainnet.base.org
